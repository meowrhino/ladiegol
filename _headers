# Fotos, loops, css y js, una hora: si se cambia una foto (aunque se llame igual),
# quien ya había entrado la ve nueva como mucho una hora después.
/projects/*
  Cache-Control: public, max-age=3600

/data/*
  Cache-Control: public, max-age=3600

/og/*
  Cache-Control: public, max-age=86400

/css/*
  Cache-Control: public, max-age=3600

/js/*
  Cache-Control: public, max-age=3600

/fonts/*
  Cache-Control: public, max-age=604800

/img/*
  Cache-Control: public, max-age=3600

/vimeo/*
  Cache-Control: public, max-age=86400
