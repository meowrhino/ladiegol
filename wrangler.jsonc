// La copia de LA DIEGOL, en Cloudflare: Workers Builds conectado a su repo
// (ladiegol/web). Cada push a main construye dist/ y lo publica en ladiegol.com.
// Con el dominio en data/site.json → "url", se indexa.
{
  "name": "ladiegol",
  "compatibility_date": "2026-10-01",
  "build": { "command": "node build/build.mjs" },
  "assets": { "directory": "./dist", "not_found_handling": "404-page" }
}
